# Variables de entorno para Inventario Casa
# Copiar este archivo como .env y completar con tus credenciales de Turso

# URL de la base de datos Turso (formato: libsql://tu-db.turso.io)
TURSO_DATABASE_URL=libsql://inventario-casa.turso.io

# Token de autenticación de Turso
TURSO_AUTH_TOKEN=tu-token-aqui
